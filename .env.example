# Copy to .env in the repo root (read by both local dev and docker compose).
# In a Hugging Face Space, set these as Space *secrets* instead - never commit real values.

ENV=dev                         # prod refuses to boot with default secrets/passwords

# --- LLM providers (either or both; with neither, the app runs in offline demo mode) ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5
CLAUDE_FAST_MODEL=claude-haiku-5-5   # planner, judge, classifier, memory summary

# Open-weight models through any OpenAI-compatible endpoint. Default: HF Inference Providers.
HF_TOKEN=
OPENWEIGHT_BASE_URL=https://router.huggingface.co/v1
OPENWEIGHT_MODEL=Qwen/Qwen2.5-72B-Instruct
# Local alternative (Ollama):
# OPENWEIGHT_BASE_URL=http://localhost:11434/v1
# OPENWEIGHT_MODEL=qwen2.5:7b
# HF_TOKEN=ollama

# --- auth (users are seeded from these on every boot) -----------------------------------
JWT_SECRET=change-me-to-a-random-64-char-string
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
STAFF_USERNAME=staff
STAFF_PASSWORD=staff123

# --- retrieval ----------------------------------------------------------------------------
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2   # or BAAI/bge-reranker-base (slower)
CONTEXT_TOP_K=6

# --- observability -------------------------------------------------------------------------
LOG_LEVEL=INFO
OTEL_EXPORTER=none              # none | console | otlp (uses OTEL_EXPORTER_OTLP_ENDPOINT)
